#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <91 93 98>;
            timeout-ms = <100>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp F1        &kp F2        &kp F3     &kp F4         &kp F5         &kp F6  &kp F7             &kp F8     &kp F9    &kp F10        &kp F11           &kp F12            &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp R
&kp GRAVE         &kp N1        &kp N2        &kp N3     &kp N4         &kp N5         &kp N6  &kp N7             &kp N8     &kp N9    &kp N0         &kp MINUS         &kp EQUAL          &kp BACKSPACE    &kp INSERT      &kp HOME         &kp PAGE_UP    &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&kp TAB           &kp Q         &kp W         &kp E      &kp R          &kp T          &kp Y   &kp U              &kp I      &kp O     &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &kp DELETE      &kp END          &kp PAGE_DOWN  &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&kp CAPS          &kp A         &kp S         &kp D      &kp F          &kp G          &kp H   &kp J              &kp K      &kp L     &kp SEMICOLON  &kp SINGLE_QUOTE  &kp ENTER          &kp KP_N4        &kp KP_N5       &kp KP_N6
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V          &kp B          &kp N   &kp M              &kp COMMA  &kp DOT   &kp SLASH      &kp RIGHT_SHIFT   &kp UP             &kp KP_N1        &kp KP_N2       &kp KP_N3        &kp KP_ENTER
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_GUI  &mo 1   &kp RIGHT_CONTROL  &kp LEFT   &kp DOWN  &kp RIGHT      &kp KP_N0         &kp KP_DOT
            >;
        };

        layer_1 {
            display-name = "1";
            bindings = <
&kp ESCAPE        &kp F1        &kp F2        &kp F3        &kp F4         &kp F5         &kp F6        &kp F7             &kp F8     &kp F9    &kp F10        &kp F11           &kp F12            &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp R
&bt BT_CLR_ALL    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &out OUT_TOG   &out OUT_BLE  &kp N7             &kp N8     &kp N9    &kp N0         &kp MINUS         &kp EQUAL          &kp BACKSPACE    &kp INSERT      &kp HOME         &kp PAGE_UP    &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&kp TAB           &kp Q         &kp W         &kp E         &kp R          &kp T          &kp Y         &kp U              &kp I      &kp O     &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &kp DELETE      &kp END          &kp PAGE_DOWN  &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&kp CAPS          &kp A         &kp S         &kp D         &kp F          &kp G          &kp H         &kp J              &kp K      &kp L     &kp SEMICOLON  &kp SINGLE_QUOTE  &kp ENTER          &kp KP_N4        &kp KP_N5       &kp KP_N6
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V          &kp B          &kp N         &kp M              &kp COMMA  &kp DOT   &kp SLASH      &kp RIGHT_SHIFT   &kp UP             &kp KP_N1        &kp KP_N2       &kp KP_N3        &kp KP_ENTER
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE     &kp RIGHT_ALT  &kp RIGHT_GUI  &trans        &kp RIGHT_CONTROL  &kp LEFT   &kp DOWN  &kp RIGHT      &kp KP_N0         &kp KP_DOT
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
