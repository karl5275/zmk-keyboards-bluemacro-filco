#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <91 93 98>;
            timeout-ms = <250>;
            layers = <0>;
        };

        // Original Convertible 2 gesture: Ctrl+Alt+Fn enters the BT device
        // picker. LEFT Ctrl (92) + LEFT Alt (94) + Fn (98). Fires the custom
        // &picker behavior: the combo invokes it on the SAME path that makes
        // profile selection work, so detection is reliable (unlike polling /
        // layer events). &picker toggles the picker in firmware: sets the
        // solid-both LED flag AND locks picker layer 2 so it latches and 1-4
        // resolve. Press 1-4 to select+exit, ESC or the chord again to cancel;
        // it also auto-cancels after 20s. timeout-ms is the chord window.
        bt_picker {
            bindings = <&picker>;
            key-positions = <92 94 98>;
            timeout-ms = <250>;
            layers = <0>;
        };
    };

    macros {
        dip1_gate: dip1_gate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&togg_on 6>, <&macro_pause_for_release>, <&togg_off 6>;

            label = "DIP1_GATE";
        };

        // Pick a BT profile, then exit the picker (&picker toggles it off,
        // force-unlocking layer 2) so the connecting/advertising LEDs show.
        bt_pick_0: bt_pick_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&picker>;
            label = "BT_PICK_0";
        };
        bt_pick_1: bt_pick_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&picker>;
            label = "BT_PICK_1";
        };
        bt_pick_2: bt_pick_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&picker>;
            label = "BT_PICK_2";
        };
        bt_pick_3: bt_pick_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&picker>;
            label = "BT_PICK_3";
        };
    };

    behaviors {
        togg_on: togg_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGG_ON";
            #binding-cells = <1>;
        };

        togg_off: togg_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOGG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        // Firmware-driven BT picker toggle (see behavior_bt_picker.c +
        // indicator_leds.c). Used by the Ctrl+Alt+Fn combo, the profile macros
        // (to exit after selecting), and ESC on the picker layer (to cancel).
        picker: picker {
            compatible = "zmk,behavior-bt-picker";
            #binding-cells = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp F1        &kp F2        &kp F3     &kp F4         &kp F5         &kp F6  &kp F7             &kp F8     &kp F9    &kp F10        &kp F11           &kp F12            &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp R
&kp GRAVE         &kp N1        &kp N2        &kp N3     &kp N4         &kp N5         &kp N6  &kp N7             &kp N8     &kp N9    &kp N0         &kp MINUS         &kp EQUAL          &kp BACKSPACE    &kp INSERT      &kp HOME         &kp PAGE_UP    &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&kp TAB           &kp Q         &kp W         &kp E      &kp R          &kp T          &kp Y   &kp U              &kp I      &kp O     &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &kp DELETE      &kp END          &kp PAGE_DOWN  &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&kp CAPS          &kp A         &kp S         &kp D      &kp F          &kp G          &kp H   &kp J              &kp K      &kp L     &kp SEMICOLON  &kp SINGLE_QUOTE  &kp ENTER          &kp KP_N4        &kp KP_N5       &kp KP_N6
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V          &kp B          &kp N   &kp M              &kp COMMA  &kp DOT   &kp SLASH      &kp RIGHT_SHIFT   &kp UP             &kp KP_N1        &kp KP_N2       &kp KP_N3        &kp KP_ENTER
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_GUI  &mo 1   &kp RIGHT_CONTROL  &kp LEFT   &kp DOWN  &kp RIGHT      &kp KP_N0         &kp KP_DOT
&dip1_gate            &trans        &trans        &trans
            >;
        };

        layer_1 {
            display-name = "1";
            bindings = <
&kp ESCAPE        &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE    &kp F4         &kp C_PREV     &kp C_PP      &kp C_STOP         &kp C_NEXT &kp F9    &kp F10        &kp F11           &kp C_SLEEP        &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &bt BT_CLR_ALL
&kp GRAVE         &trans        &trans        &trans        &trans         &out OUT_TOG   &kp N6        &kp N7             &kp N8     &kp N9    &kp N0         &kp MINUS         &kp EQUAL          &kp BACKSPACE    &kp INSERT      &kp HOME         &kp PAGE_UP    &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&kp TAB           &kp Q         &kp W         &kp E         &kp R          &kp T          &kp Y         &kp U              &kp I      &kp O     &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &kp DELETE      &kp END          &kp PAGE_DOWN  &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&kp CAPS          &kp A         &kp S         &kp D         &kp F          &kp G          &kp H         &kp J              &kp K      &kp L     &kp SEMICOLON  &kp SINGLE_QUOTE  &kp ENTER          &kp KP_N4        &kp KP_N5       &kp KP_N6
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V          &kp B          &kp N         &kp M              &kp COMMA  &kp DOT   &kp SLASH      &kp RIGHT_SHIFT   &kp UP             &kp KP_N1        &kp KP_N2       &kp KP_N3        &kp KP_ENTER
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE     &kp RIGHT_ALT  &kp RIGHT_GUI  &trans        &kp RIGHT_CONTROL  &kp LEFT   &kp DOWN  &kp RIGHT      &kp KP_N0         &kp KP_DOT
&trans            &trans        &trans        &trans
            >;
        };

        bt_picker_layer {
            display-name = "BT";
            bindings = <
&picker  &none       &none       &none       &none       &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none   &bt_pick_0  &bt_pick_1  &bt_pick_2  &bt_pick_3  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
            >;
        };

        Dip_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &none   &trans  &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
            >;

            label = "Dip 1";
        };
    };
};
